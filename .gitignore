
# ==========================================
# FACTURIO - Git Ignore
# ==========================================

# Dependencies
node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example

# Build outputs
dist/
build/

# Test coverage
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Editor temporary files
*.swp
*.swo

# Local temporary files
*.tmp
*.bak

# Local development files
*.local
